# Backend .env.example
# Copy this file to backend/.env and fill in secure values

# Server
PORT=9500
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=roller_user
DB_PASSWORD=change_me
DB_DATABASE=roller_derby

# JWT
JWT_SECRET=long_random_string_minimum_32_characters
JWT_EXPIRES_IN=1d

# CORS
CORS_ORIGINS=http://localhost:3000

# File uploads
UPLOAD_DIR=./public/uploads

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=