# Backend .env.example
# Copy to backend/.env and fill in secure values

# Server
PORT=9500
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=roller_user
DB_PASSWORD=change_me
DB_NAME=roller_derby

# JWT
JWT_SECRET=please_change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d

# CORS
CORS_ORIGINS=http://localhost:5173

# File uploads
UPLOAD_DIR=./public/uploads

# Stripe (optional; if not used, leave empty)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
